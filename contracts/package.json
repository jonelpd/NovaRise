{
  "name": "nvra-experimental-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only experimental NVRA fixed-supply token. No deployment scripts or private keys.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "preflight": "node scripts/preflight.cjs",
